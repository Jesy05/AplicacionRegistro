<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.aplicacionregistro.controller.DetalleController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Detalle del cliente"/>

    <HBox spacing="20.0">
        <ImageView fx:id="imgFoto" fitHeight="120.0" fitWidth="120.0" preserveRatio="true"/>

        <GridPane hgap="10.0" vgap="8.0">
            <Label text="Nombre completo:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Tipo de cliente:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblTipoCliente" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Ciudad:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblCiudad" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Fecha de nacimiento:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblFechaNacimiento" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Tipo de solicitud:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblTipoSolicitud" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Servicios de interés:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="lblServicios" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        </GridPane>
    </HBox>

    <HBox alignment="CENTER">
        <Button text="Cerrar" onAction="#onCerrarClick"/>
    </HBox>
</VBox>